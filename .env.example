# Copy this file to .env.local and fill in whichever keys you have.
# The app works with ZERO keys filled in — it falls back to local, rule-based
# scoring and a heuristic auto-fix. Add keys to unlock AI-quality feedback and
# rewriting. See docs/RESUME_ATS_CHECKER_PLAN.md §10 for where each one comes
# from and its free-tier shape.
#
# The router tries these in order and falls back automatically:
# GEMINI -> GROQ -> OPENROUTER. None are required.

# Google AI Studio: https://aistudio.google.com/app/apikey (free tier, no card)
GEMINI_API_KEY=

# Groq Console: https://console.groq.com/keys (free tier, no card)
GROQ_API_KEY=

# OpenRouter: https://openrouter.ai/keys (free ":free"-tagged models, no card)
OPENROUTER_API_KEY=

# --- Optional: per-visitor rate limiting for the shared free-tier pool ---
DAILY_FREE_ANALYSES_PER_IP=5

# --- Optional: only needed if you build out the PayPal SDK donate flow ---
NEXT_PUBLIC_PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
